# Copy this file to .env and fill in real values. Never commit .env itself.

# You invent this yourself - any random string. You'll enter the SAME
# value into the Meta dashboard when registering the webhook.
VERIFY_TOKEN=choose_any_random_string_here

# From Meta dashboard > WhatsApp > API Setup (temporary token, 24h)
WHATSAPP_TOKEN=

# From Meta dashboard > WhatsApp > API Setup, "Phone number ID"
PHONE_NUMBER_ID=

# Comma-separated, no spaces, no "+" prefix - e.g. 919999999999,918888888888
ALLOWED_NUMBERS=



# From aistudio.google.com/apikey - used in Box 3 for parsing
GEMINI_API_KEY=

# From console.groq.com - hosts Whisper for transcription (Box 2)
GROQ_API_KEY=

# Box 3: phone number -> default delivery address, format "number:address,number:address"
# e.g. 919999999999:Moms Home,918888888888:Dads Home
ADDRESS_MAP=

# Box 6 safety: real checkout is BLOCKED above this amount (Rs). CART
# path is unaffected. Raise this once you trust the pipeline fully.
MAX_ORDER_AMOUNT=500
